POSTGRES_USER=savdo
POSTGRES_PASSWORD=savdo
POSTGRES_DB=savdo
DATABASE_URL=postgres://savdo:savdo@localhost:5432/savdo?sslmode=disable
API_ADDR=:8080

# Media (ADR-008). MEDIA_DIR is relative to cmd/api's working directory —
# `make api` runs it from api/, so this lands at repo-root
# infra/data/media/ (gitignored); in prod it is the Docker volume mounted
# at /data/media (docs/07-DEVOPS.md § Production).
MEDIA_DIR=../infra/data/media
MEDIA_BASE_URL=/media
MEDIA_MAX_BYTES=10485760

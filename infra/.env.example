POSTGRES_USER=savdo
POSTGRES_PASSWORD=savdo
POSTGRES_DB=savdo
DATABASE_URL=postgres://savdo:savdo@localhost:5432/savdo?sslmode=disable
API_ADDR=:8080

# Media (ADR-008, O-16). MEDIA_DIR is relative to cmd/api's working directory —
# `make api` runs it from api/, so this lands at repo-root
# infra/data/media/ (gitignored); in prod it must be an absolute path and is
# the Docker volume mounted at /data/media (docs/07-DEVOPS.md § Production).
# See docs/07-DEVOPS.md § Environment variables for all options.
MEDIA_DIR=../infra/data/media
MEDIA_BASE_URL=/media
MEDIA_MAX_BYTES=10485760
MEDIA_CONCURRENCY=2
MEDIA_QUEUE=8

# Public landing (Phase 6, D-105). The shop GET /public/* serves; see
# docs/07-DEVOPS.md § Environment variables.
PUBLIC_SHOP_SLUG=savdo-demo

# LLM adapter (ADR-009, Phase 7 T2). internal/ai.Config's Provider/Model
# and the two per-million-token USD prices its cost estimate is computed
# from (O-28); see docs/07-DEVOPS.md § Environment variables.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
AI_PRICE_INPUT_PER_MTOK=2.00
AI_PRICE_OUTPUT_PER_MTOK=10.00

# ANTHROPIC_API_KEY (secret, D-112): the anthropic provider's credential,
# read by the SDK's default client — never set in the repo, owner-provided
# in infra/.env only.
ANTHROPIC_API_KEY=

# AI_BASE_URL and AI_API_KEY: only for AI_PROVIDER=openai_compat, a
# self-hosted OpenAI-compatible endpoint (Ollama, vLLM, …). AI_BASE_URL is
# required for that provider (e.g. http://localhost:11434/v1); AI_API_KEY
# is optional (secret, D-112) — many self-hosted endpoints need no auth.
AI_BASE_URL=
AI_API_KEY=

# Telegram (Phase 7, ADR-005, D-112). Required in prod; Telegram
# login/link/OTP disabled in dev until set — config.Load() only fails fast
# at startup on an empty value when ENV=prod (same precedent as MEDIA_DIR's
# prod-only absolute-path check). BOT_USERNAME is not a secret (it is the
# bot's own @handle, embedded in the deep link POST /auth/telegram/link
# returns); TELEGRAM_BOT_TOKEN is — owner-provided in infra/.env only,
# never in the repo or logs.
BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

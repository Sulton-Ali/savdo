{
  "enabledMcpjsonServers": [
    "context7"
  ],
  "permissions": {
    "allow": [
      "Bash(make verify)",
      "Bash(make generate)",
      "Bash(make dev-infra)",
      "Bash(make dev-infra-down)",
      "Bash(make migrate)",
      "Bash(make seed)",
      "Bash(make api)",
      "Bash(make bot)",
      "Bash(make test:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go run:*)",
      "Bash(go mod tidy)",
      "Bash(go mod download)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint:*)",
      "Bash(sqlc:*)",
      "Bash(goose status:*)",
      "Bash(pnpm install)",
      "Bash(pnpm -r typecheck)",
      "Bash(pnpm -r test)",
      "Bash(pnpm -r test:*)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm biome:*)",
      "Bash(pnpm exec biome:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec playwright:*)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git worktree list)",
      "Bash(docker compose exec postgres psql:*)",
      "Bash(go tool:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh repo create:*)",
      "Bash(goose up:*)",
      "Bash(goose down:*)",
      "Bash(docker compose down:*)"
    ],
    "deny": [
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(docker compose down -v)",
      "Bash(psql:* DROP*)",
      "Read(./infra/.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Bash(docker compose exec postgres psql:* DROP*)",
      "Bash(docker compose exec postgres psql:* TRUNCATE*)"
    ]
  }
}

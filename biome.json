{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.output",
      "!**/gen",
      "!**/node_modules",
      "!api",
      "!packages/api-client/src/schema.d.ts",
      "!web/src/routeTree.gen.ts",
      "!web/test-results",
      "!web/playwright-report",
      "!web/.lighthouse",
      "!.claude",
      "!.mcp.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
